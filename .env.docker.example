# Used by docker-compose.external.yml — copy to .env and fill in real values.
MONGO_URI=mongodb+srv://user:password@your-cluster.mongodb.net/framefusion
REDIS_URL=redis://default:password@your-redis-host:6379

UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MAX_FILE_SIZE_MB=500
CLEANUP_MAX_AGE_HOURS=24
LOG_LEVEL=info
